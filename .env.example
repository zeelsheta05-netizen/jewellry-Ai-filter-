# Copy to .env (same folder) and fill in. Never share or commit .env (it stays mode 600).

# --- Supabase: Project Settings -> API (or "API Keys")
SUPABASE_URL=
# The SECRET key (sb_secret_... or the legacy service_role key), NOT the anon/publishable one.
SUPABASE_SECRET_KEY=

# --- Dataset storage (jewelsearch/storage.py). Where the dataset is, as a URL:
#   file:///Volumes/Storage   the SSD (until the move)
#   s3://<bucket>             the bucket (scripts/migrate_to_s3.py connect sets this)
JEWEL_STORAGE=file:///Volumes/Storage
# During the move only (connect sets it, finish removes it): files not moved yet are read from here.
# JEWEL_STORAGE_FALLBACK=file:///Volumes/Storage

# --- S3 provider (from the provider's console; an access key for this bucket only)
S3_BUCKET=
# AWS: e.g. ap-south-1 (Mumbai). Cloudflare R2: auto. DigitalOcean: blr1. Akamai: e.g. in-maa-1. Zata.ai: us-east-1.
S3_REGION=
# Empty for AWS. Others, from their console, e.g.
#   https://<account id>.r2.cloudflarestorage.com      Cloudflare R2
#   https://blr1.digitaloceanspaces.com                DigitalOcean Spaces, Bangalore
#   https://bom01.zata.ai  or  https://idr01.zata.ai   Zata.ai, Mumbai or Indore
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional
# STORAGE_CACHE_GB=20          local cache for CAD files fetched from the bucket
# S3_ORIGINALS_CLASS=          storage class for originals (AWS default INTELLIGENT_TIERING)
# S3_CONDITIONAL_WRITES=1      refuse overwrites in the bucket itself (on by default for AWS)

# Sketch to Design (/sketch, jewelsearch/sketch.py): pictures are made on the server through a wrapper.
# Set one or both keys; only models of connected providers are offered (free-credit models first).
# LOCAL_IMAGEGEN=0             switch off drawing on this Mac (on when .venv-imagegen + weights exist)
# LOCAL_MIN_FREE_GB=2.0        free memory needed before a local picture starts
# POLLINATIONS_KEY=sk_...      secret key from enter.pollinations.ai/keys (free account: quest credits pay for
#                              FLUX Kontext / Klein / GPT Image mini; Nano Banana there needs paid credits)
# POLLINATIONS_PAID=1          show Nano Banana via Pollinations (only after buying paid credits there)
# GEMINI_API_KEY=              Google direct Nano Banana (no free tier: the project needs billing)
# SKETCH_PER_USER_DAY=20       AI pictures per user per day
# SKETCH_USD_DAY=2.00          whole-team spend cap per day (checked before every call; 1 pollen ~ 1 USD)
# SKETCH_USD_MONTH=10.00       whole-team spend cap per month
# SKETCH_INR_PER_USD=88        only for the rupee price shown on the page
